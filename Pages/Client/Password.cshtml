@model RentalManager.Pages.Client.PasswordModel
<!doctype html><html><head><meta name="viewport" content="width=device-width,initial-scale=1"><title>Client password · Chwaya House</title><link rel="stylesheet" href="/base.css"></head><body><section class="auth"><div class="login"><h1>Set your client password</h1><p>Replace your temporary password before opening the portal.</p><form method="post"><div asp-validation-summary="All" class="error"></div><label>Current password<input asp-for="CurrentPassword" type="password" autocomplete="current-password" required></label><label>New password<input asp-for="NewPassword" type="password" autocomplete="new-password" minlength="12" maxlength="200" required></label><label>Confirm new password<input asp-for="ConfirmPassword" type="password" autocomplete="new-password" required></label><button class="primary">Save and sign in again</button></form><a href="/Client/Logout">Sign out</a></div></section></body></html>
