@page
@model RentalManager.Pages.Account.PasswordModel
<!doctype html><html><head><title>Change password</title><link rel="stylesheet" href="/base.css"></head><body><section class="auth"><div class="login"><h1>Change password</h1><form method="post"><div asp-validation-summary="All" class="error"></div><label>Current password<input asp-for="CurrentPassword" type="password" autocomplete="current-password" required></label><label>New password<input asp-for="NewPassword" type="password" autocomplete="new-password" required minlength="12"></label><label>Confirm new password<input asp-for="ConfirmPassword" type="password" required autocomplete="new-password"></label><button class="primary">Save and sign out</button></form><p><a href="/settings">Cancel</a></p></div></section></body></html>
