@inject NavigationManager Navigation
@inject AuthenticationStateProvider Authentication
@code {
 protected override async Task OnInitializedAsync(){var user=(await Authentication.GetAuthenticationStateAsync()).User;var path=Navigation.ToBaseRelativePath(Navigation.Uri);var target=user.IsInRole("Client")?(user.FindFirst("passwordChangeRequired")?.Value=="true"?"/Client/Password":"/client"):path.StartsWith("client",StringComparison.OrdinalIgnoreCase)?"/Client/Login":"/Account/Login";Navigation.NavigateTo(target,true);}
}
