@inject RentalService Service
@inject ILogger<RecordEditor> Logger
<section class="editor">
 <h2>@(Record.Id==0?"Add record":"Edit record")</h2>
 <EditForm Model="@Record" OnValidSubmit="Save" FormName="record-editor">
  <DataAnnotationsValidator /><ValidationSummary />
  @if(Record is Property){<p class="hint">Advertised rent is the suggested price. Reports use the agreed rent on the lease; these amounts are not added together.</p>}
  @if(Record is Lease){<p class="hint">This is the single monthly charge for this lease. Deposit is separate and is not monthly rent.</p>}
  @if(Record is Payment){<p class="hint">Enter only the money received in this payment. A payment reduces the rent balance; it does not add another rent charge.</p>}
  <div class="formGrid">
   @foreach(var field in Fields) {
    var options=Options(field.Name);
    <label class="@(IsLong(field)?"full":"")">
     @Label(field.Name) @(field.IsDefined(typeof(RequiredAttribute),true)?"*":"")
     @if(Record is Payment && field.Name=="Period") {
      <input type="month" disabled="@Busy" value="@(((Payment)Record).Period.ToString("yyyy-MM"))" @onchange="ChangePeriod" />
     } else if(field.PropertyType==typeof(bool)) {
      <input type="checkbox" checked="@((bool)field.GetValue(Record)!)" disabled="@Busy" @onchange="e=>Change(field,e)" />
     } else if(options.Count>0 || new[]{"PropertyId","TenantId","LeaseId"}.Contains(field.Name)) {
      <select disabled="@Busy" @onchange="e=>Change(field,e)">
       @if(field.PropertyType==typeof(int)){<option value="0" selected="@(Format(field)=="0")">Select…</option>}
       @foreach(var option in options){<option value="@option.Value" selected="@(Format(field)==option.Value)">@option.Label</option>}
      </select>
     } else if(IsLong(field)) {
      <textarea disabled="@Busy" maxlength="@MaxLength(field)" value="@Format(field)" @onchange="e=>Change(field,e)"></textarea>
     } else {
      <input disabled="@Busy" type="@InputType(field)" step="@(field.PropertyType==typeof(int)?"1":"0.01")" maxlength="@MaxLength(field)" value="@Format(field)" @onchange="e=>Change(field,e)" />
     }
    </label>
   }
  </div>
  @if(!string.IsNullOrEmpty(Error)){<p class="error" role="alert">@Error</p>}
  <div class="actions"><button class="primary" disabled="@Busy" type="submit">@(Busy?"Saving…":"Save changes")</button><button type="button" disabled="@Busy" @onclick="OnCancel">Cancel</button></div>
 </EditForm>
</section>
@code {
 [Parameter,EditorRequired] public IEntity Record {get;set;}=default!;
 [Parameter,EditorRequired] public RentalData Data {get;set;}=default!;
 [Parameter] public EventCallback OnSaved {get;set;}
 [Parameter] public EventCallback OnCancel {get;set;}
 bool Busy;string Error="";
 IEnumerable<System.Reflection.PropertyInfo> Fields=>Record.GetType().GetProperties().Where(p=>p.Name!="Id"&&p.Name!="RowVersion"&& !(Record is Property prop&&((prop.Kind=="House"&&p.Name=="BusinessType")||(prop.Kind=="Shop"&&p.Name=="Bedrooms"))));
 string Label(string s)=>s switch{"MonthlyRent" when Record is Property=>"Advertised monthly rent","MonthlyRent" when Record is Lease=>"Agreed monthly rent","Amount" when Record is Payment=>"Amount paid (this payment)","PropertyId"=>"House / shop","TenantId"=>"Tenant","LeaseId"=>"Lease","Period"=>"Rental period (month)","FloorArea"=>"Floor area (m²)","BusinessType"=>"Permitted business activity",_=>System.Text.RegularExpressions.Regex.Replace(s,"([a-z])([A-Z])","$1 $2")};
 string Format(System.Reflection.PropertyInfo p)=>p.GetValue(Record) switch{DateOnly d=>d.ToString("yyyy-MM-dd"),decimal n=>n.ToString(CultureInfo.InvariantCulture),null=>"",var v=>v.ToString()??""};
 static bool IsLong(System.Reflection.PropertyInfo p)=>new[]{"Amenities","SpecialTerms","ContractTerms","Notes"}.Contains(p.Name);
 static int MaxLength(System.Reflection.PropertyInfo p)=>p.GetCustomAttributes(typeof(StringLengthAttribute),true).Cast<StringLengthAttribute>().FirstOrDefault()?.MaximumLength??250;
 static string InputType(System.Reflection.PropertyInfo p)=>p.PropertyType==typeof(DateOnly)?"date":p.PropertyType==typeof(int)||p.PropertyType==typeof(decimal)?"number":p.Name=="Email"?"email":"text";
 List<(string Value,string Label)> Options(string name)=>name switch{
  "Kind" when Record is Property=>[("House","House"),("Shop","Shop")],
  "Status"=>[("Active","Active"),("Ended","Ended"),("Cancelled","Cancelled")],
  "Kind" when Record is Payment=>[("Rent","Rent"),("Deposit","Deposit"),("Other","Other")],
  "Method"=>[("Bank transfer","Bank transfer"),("Cash","Cash"),("Mobile money","Mobile money")],
  "PropertyId"=>Data.Properties.Select(x=>(x.Id.ToString(),$"{x.Kind} · {x.Name}")).ToList(),
  "TenantId"=>Data.Tenants.Select(x=>(x.Id.ToString(),x.FullName)).ToList(),
  "LeaseId"=>Data.Leases.Select(x=>(x.Id.ToString(),$"#{x.Id} · {Data.PropertyName(x.PropertyId)} · {Data.TenantName(x.TenantId)}")).ToList(),
  _=>[]
 };
 void ChangePeriod(ChangeEventArgs args){
  if(DateOnly.TryParseExact((args.Value?.ToString()??"")+"-01","yyyy-MM-dd",CultureInfo.InvariantCulture,DateTimeStyles.None,out var month)){((Payment)Record).Period=month;Error="";}
  else Error="Enter a valid value for Rental period (month).";
 }
 void Change(System.Reflection.PropertyInfo field,ChangeEventArgs args){
  try{
   var text=args.Value?.ToString()??"";
   object? value=field.PropertyType==typeof(bool)?args.Value is true:field.PropertyType==typeof(int)?int.Parse(text,CultureInfo.InvariantCulture):field.PropertyType==typeof(decimal)?decimal.Parse(text,CultureInfo.InvariantCulture):field.PropertyType==typeof(DateOnly)?DateOnly.ParseExact(text,"yyyy-MM-dd",CultureInfo.InvariantCulture):field.Name=="Email"&&string.IsNullOrWhiteSpace(text)?null:text.Trim();
   field.SetValue(Record,value);Error="";
   if(Record is Lease l&&field.Name=="PropertyId"){var prop=Data.Properties.FirstOrDefault(p=>p.Id==l.PropertyId);if(prop!=null&&l.Id==0)l.MonthlyRent=prop.MonthlyRent;}
   if(Record is Payment payment && payment.Id==0 && (field.Name=="LeaseId" || field.Name=="Kind") && payment.Kind=="Rent" && payment.Amount==0){var lease=Data.Leases.FirstOrDefault(x=>x.Id==payment.LeaseId);if(lease!=null)payment.Amount=lease.MonthlyRent;}
   if(Record is Property shop&&shop.Kind=="Shop")shop.Bedrooms=0;
  }catch(FormatException){Error=$"Enter a valid value for {Label(field.Name)}.";}
 }
 async Task Save(EditContext context){if(Busy||Error.StartsWith("Enter a valid value"))return;Busy=true;Error="";try{await Service.SaveAsync(Record);await OnSaved.InvokeAsync();}catch(Exception e){Logger.LogError(e,"Rental record save failed");Error=RentalService.Error(e);}finally{Busy=false;}}
}
