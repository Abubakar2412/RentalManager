
@page "/payments"

@attribute [Authorize]
@inject NavigationManager Navigation
@inject RentalService Service
@inject IJSRuntime JS
@inject ILogger<Records> Logger
<PageTitle>@Title · Chwaya Rental Manager</PageTitle>
<header><div><div class="eyebrow">PROPERTY MANAGEMENT</div><h1>@Title</h1><p>@Description</p></div></header>
<PdfReport Title="Payments report" />
@if (!string.IsNullOrEmpty(Message))
{
    <div class="notice" role="status">@Message</div>
}
@if (Data is null)
{
    <p>Loading records…</p>
}
else
{
    <div class="toolbar"><input @bind="Search" @bind:event="oninput" placeholder="Search records…" aria-label="Search" /><div><button @onclick="Refresh" disabled="@Busy">Refresh</button><button @onclick="Export">Export monthly allocations CSV</button><button class="primary" @onclick="Add">+ Add @Singular</button></div></div>
    @if (Editor is not null)
    {
        <RecordEditor @key="Editor" Record="Editor" Data="Data" OnSaved="Saved" OnCancel="Cancel" />
    }
    @if (ToDelete is not null)
    {
        <div class="deleteConfirm">Delete this @Singular? Linked records are protected. <button class="danger" disabled="@Busy" @onclick="Delete">Confirm delete</button><button @onclick="() => ToDelete = null">Cancel</button></div>
    }
    <div class="panel tableWrap"><table>
    <thead><tr><th>Reference</th><th>Tenant / property</th><th>Paid on</th><th>Months covered</th><th>Total paid</th><th>Kind</th><th>Method</th><th>Actions</th></tr></thead>
    <tbody>
    @foreach(var receipt in Receipts) {
      var payment=receipt.First;var lease=Data.Leases.FirstOrDefault(l=>l.Id==payment.LeaseId);
      <tr><td>@receipt.Reference</td><td>@(lease is null ? $"Lease #{payment.LeaseId}" : $"{Data.TenantName(lease.TenantId)} · {Data.PropertyName(lease.PropertyId)}")</td>
      <td>@payment.PaidOn.ToString("yyyy-MM-dd")</td><td>@receipt.Start.ToString("MMM yyyy")@(receipt.Payments.Count>1 ? " – "+receipt.End.ToString("MMM yyyy") : "") · @receipt.Payments.Count month(s)</td>
      <td>@Data.Money(receipt.Total)</td><td>@payment.Kind</td><td>@payment.Method</td>
      <td>@if(receipt.Payments.Count==1){<button @onclick="()=>Edit(payment)">Edit</button><button class="danger" @onclick="()=>ToDelete=payment">Delete</button>}
      else {<button @onclick="()=>Toggle(receipt.First.Id)">@(Expanded.Contains(receipt.First.Id) ? "Hide months" : "View / edit months")</button>}</td></tr>
      @if(receipt.Payments.Count>1 && Expanded.Contains(receipt.First.Id)) {
       <tr><td colspan="8"><table><thead><tr><th>Rental month</th><th>Allocated amount</th><th>Actions</th></tr></thead><tbody>
       @foreach(var part in receipt.Payments){<tr><td>@part.Period.ToString("MMMM yyyy")</td><td>@Data.Money(part.Amount)</td><td><button @onclick="()=>Edit(part)">Edit allocation</button><button class="danger" @onclick="()=>ToDelete=part">Delete allocation</button></td></tr>}
       </tbody></table></td></tr>
      }
    }
    @if(!Receipts.Any()){<tr><td colspan="8" class="empty">No payments found.</td></tr>}
    </tbody></table></div>

@if (Section == "payments")
{
    <p class="hint">Multi-month payments appear once with their combined total. Expand a payment to edit its monthly allocations. Monthly reports still use the individual allocations.</p>
}
}
@code {
    HashSet<int> Expanded=[];
    void Toggle(int id){if(!Expanded.Add(id))Expanded.Remove(id);}
    IEnumerable<PaymentReceipt> Receipts => Data is null ? [] : PaymentReceipts.Group(Data.Payments).Where(r=>string.IsNullOrWhiteSpace(Search) || (r.Reference+" "+r.First.LeaseId+" "+r.First.PaidOn+" "+r.First.Method+" "+r.First.Kind+" "+r.Start+" "+r.End+" "+r.Total).Contains(Search,StringComparison.OrdinalIgnoreCase) || Data.Leases.Any(l=>l.Id==r.First.LeaseId && (Data.TenantName(l.TenantId)+" "+Data.PropertyName(l.PropertyId)).Contains(Search,StringComparison.OrdinalIgnoreCase)) || r.Payments.Any(p=>p.Reference.Contains(Search,StringComparison.OrdinalIgnoreCase)));
    RentalData? Data; IEntity? Editor; IEntity? ToDelete; string Section = "houses", Search = "", Message = ""; bool Busy;
    string Title => CultureInfo.CurrentCulture.TextInfo.ToTitleCase(Section);
    string Singular => Section switch { "houses" => "house", "shops" => "shop", "tenants" => "tenant", "leases" => "lease", _ => "payment" };
    string Description => Section switch { "houses" => "Bedroom counts, availability and residential rent.", "shops" => "Commercial units, floor area and shop rent.", "tenants" => "National ID, contact, bank and account details.", "leases" => "House and shop agreements in one workflow.", _ => "Receipts for houses and shops." };
    protected override async Task OnParametersSetAsync()
    {
        Section = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0].Trim('/'); Editor = null; ToDelete = null; Search = ""; Message = "";
        await Refresh();
    }

    async Task Refresh()
    {
        try
        {
            Data = await Service.LoadAsync();
        }
        catch (Exception e)
        {
            Message = RentalService.Error(e);
            Logger.LogError(e, "Loading rental records failed");
        }

    }

    IEnumerable<IEntity> Items => Data is null ? [] : Section
    switch
    {
        "houses" => Data.Properties.Where(p => p.Kind == "House").Cast<IEntity>(),
        "shops" => Data.Properties.Where(p => p.Kind == "Shop").Cast<IEntity>(),
        "tenants" => Data.Tenants.Cast<IEntity>(),
        "leases" => Data.Leases.Cast<IEntity>(),
        _ => Data.Payments.Cast<IEntity>()
    };

    IEnumerable<IEntity> Filtered => Items.Where(x => string.IsNullOrWhiteSpace(Search) || string.Join(" ", x.GetType().GetProperties().Where(p => p.Name != "RowVersion").Select(p => p.GetValue(x))).Contains(Search, StringComparison.OrdinalIgnoreCase) || (x is Lease l && $"{Data!.PropertyName(l.PropertyId)} {Data.TenantName(l.TenantId)}".Contains(Search, StringComparison.OrdinalIgnoreCase)));
    string[] Columns => Section
    switch
    {
        "houses" => ["Name", "Address", "Bedrooms", "Bathrooms", "MonthlyRent", "Available"],
        "shops" => ["Name", "Address", "FloorArea", "BusinessType", "MonthlyRent", "Available"],
        "tenants" => ["FullName", "NationalId", "Phone", "Email", "BankName", "AccountName", "AccountNumber"],
        "leases" => ["Id", "PropertyId", "TenantId", "StartDate", "EndDate", "MonthlyRent", "Deposit", "Status"],
        _ => ["Reference", "LeaseId", "PaidOn", "Period", "Amount", "Kind", "Method"]
    };

    static string Label(string s) => s switch { "PropertyId" => "House / shop", "TenantId" => "Tenant", "LeaseId" => "Lease", _ => System.Text.RegularExpressions.Regex.Replace(s, "([a-z])([A-Z])", "$1 $2") };
    async Task<string> Value(IEntity record, string key)
    {
        if (record is Property prop && key == "Available") return Data!.Leases.Any(l => l.PropertyId == prop.Id && Data.IsCurrent(l)) ? "Occupied" : prop.Available ? "Available" : "Unavailable";
        if (key == "PropertyId") return Data!.PropertyName((int)record.GetType().GetProperty(key)!.GetValue(record)!);
        if (key == "TenantId") return Data!.TenantName((int)record.GetType().GetProperty(key)!.GetValue(record)!);
        var v = record.GetType().GetProperty(key)?.GetValue(record);
        return v switch { decimal d when key == "MonthlyRent" || key == "Deposit" || key == "Amount" => Data!.Money(d), DateOnly d => d.ToString("yyyy-MM-dd"), bool b => b ? "Available" : "Unavailable", null => "", _ => v.ToString() ?? "" };

    }

    void Add()
    {
        Message = ""; Editor = Section switch
        {
            "houses" => new Property
            {
                Kind = "House"
            },
            "shops" => new Property { Kind = "Shop", Bedrooms = 0 },
            "tenants" => new Tenant(),
            "leases" => new Lease(),
            _ => new Payment()
        };
    }
    void Edit(IEntity item) { Message = ""; Editor = (IEntity)System.Text.Json.JsonSerializer.Deserialize(System.Text.Json.JsonSerializer.Serialize(item, item.GetType()), item.GetType())!; }
    void Cancel() { Editor = null; }
    async Task Saved() { Editor = null; await Refresh(); Message = "Record saved."; }
    async Task Delete() { if (ToDelete is null || Busy) return; Busy = true; try { await Service.DeleteAsync(ToDelete); ToDelete = null; await Refresh(); Message = "Record deleted."; } catch (Exception e) { Message = RentalService.Error(e); Logger.LogError(e, "Delete failed"); } finally { Busy = false; } }
    async Task Generate(int id) { if (Busy) return; Busy = true; try { var contract = await Service.GenerateContractAsync(id); await Refresh(); Message = $"Contract #{contract} saved. Open Contracts to print or save as PDF."; } catch (Exception e) { Message = RentalService.Error(e); Logger.LogError(e, "Contract generation failed"); } finally { Busy = false; } }
    async Task Export() => await JS.InvokeVoidAsync("rental.download", $"{Section}-{DateTime.Today:yyyy-MM-dd}.csv", CsvExport.Records(Filtered), "text/csv;charset=utf-8");
    async Task Statement(Lease l) { await JS.InvokeVoidAsync("rental.download", $"lease-{l.Id}-statement.csv", CsvExport.Statement(l, Data!), "text/csv;charset=utf-8"); Message = "Statement downloaded. Each intersecting calendar month is charged a full month's rent; no proration. Deposits and other payments are excluded."; }
}
