@page "/settings"
@attribute [Authorize]
@inject RentalService Service
<PageTitle>Settings · Chwaya Rental Manager</PageTitle>
<header><div><h1>Landlord &amp; settings</h1><p>Bank account details and standard agreement terms.</p></div></header>

@if(Message.Length>0){<p class="notice">@Message</p>}
@if(Data is not null){
<section id="landlord-report"><h2>Saved landlord details</h2><PdfReport Target="landlord-report" Title="Landlord settings report" />
<table><tbody>@foreach(var field in typeof(Landlord).GetProperties().Where(p=>p.Name!="RowVersion")){<tr><th>@field.Name</th><td>@field.GetValue(Data.Landlord)</td></tr>}</tbody></table></section>
<RecordEditor @key="Data.Landlord" Record="Data.Landlord" Data="Data" OnSaved="Saved" OnCancel="Load" /><p class="hint">Changes apply to new contracts. Saved contract snapshots remain unchanged.</p><a href="/Account/Password" data-enhance-nav="false">Change administrator password</a>}
@code{
 RentalData? Data;string Message="";
 protected override async Task OnInitializedAsync()=>await Load();
 async Task Load(){try{Data=await Service.LoadAsync(RentalLoadScope.Core);}catch(Exception e){Message=RentalService.Error(e);}}
 async Task Saved(){await Load();Message="Settings saved.";}
}
